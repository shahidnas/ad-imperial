# Copy this file to .env.local and fill in the values you have.
# Every variable is optional — the site builds and runs without any of them.

# --- Site ---------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, the sitemap and robots.txt. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Business contact details --------------------------------------------
# Official values are set in src/lib/site.ts. These override them per env.
# Anything left blank is hidden from the UI (no dead links / placeholders).
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number, digits only with country code, e.g. 919876543210
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_GSTIN=

# ===========================================================================
# CONTACT FORM DELIVERY — EMAIL (Nodemailer / SMTP)
# ===========================================================================
# Contact-form leads are emailed to CONTACT_RECIPIENT_EMAIL (default:
# nayeem.akhtar181@gmail.com). The SMTP_* values below are ONLY the SENDER
# account's credentials — they are read server-side only and are never
# exposed to the browser. Until they are filled in, submissions are
# validated correctly but only logged server-side (delivered: false) —
# nothing is silently pretended to be sent.
#
# RECOMMENDED SETUP (free) — Gmail SMTP with an "App Password" on the
# SENDER Gmail account:
#
#   1. Sign in to https://myaccount.google.com/security with the sender
#      Gmail account.
#   2. Turn on "2-Step Verification" if it isn't already on (required for
#      step 3).
#   3. Go to https://myaccount.google.com/apppasswords and create an app
#      password (e.g. "AD Imperial Website"). Copy the 16-character code.
#   4. Put that code in SMTP_PASSWORD below (NOT the normal Gmail login
#      password).
#   5. Set SMTP_USER (and optionally SMTP_FROM) to the sender address.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465            (or 587 with STARTTLS)
#   SMTP_SECURE=true         (for 465)
#   SMTP_USER=<sender Gmail address>
#   SMTP_PASSWORD=<16-character app password>
#   SMTP_FROM=<sender Gmail address, optionally with a display name>
#
# Gmail's sending cap (~500/day) is far above a small business contact
# form. Any other SMTP provider (e.g. Brevo's free tier, Zoho, Outlook)
# works too — only these SENDER values change; the recipient stays the same.
SMTP_HOST=
SMTP_PORT=
# "true" for port 465 (implicit TLS). Leave blank to auto-detect from the
# port (465 = true, anything else = STARTTLS, e.g. 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to SMTP_USER if left blank. Can be a display name,
# e.g. "AD Imperial Website" <sender@example.com>
SMTP_FROM=
# Recipient of contact-form leads. Defaults to nayeem.akhtar181@gmail.com in code
# (src/lib/mailer.ts) — this is not the SMTP sender account.
CONTACT_RECIPIENT_EMAIL=

# --- Contact form delivery: webhook (optional, in addition to email) ------
# If set, contact-form submissions are ALSO POSTed here as JSON. Works with
# a Zapier / Make / n8n catch hook, a Slack/Discord incoming webhook, or
# your own endpoint. Independent of the email settings above.
CONTACT_WEBHOOK_URL=
