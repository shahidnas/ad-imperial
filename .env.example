# Copy this file to .env.local and fill in the values you have.
# Every variable is optional — the site builds and runs without any of them.

# --- Site ---------------------------------------------------------------
# Production origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, the sitemap and robots.txt. Defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Business contact details --------------------------------------------
# Official values are set in src/lib/site.ts. These override them per env.
# Anything left blank is hidden from the UI (no dead links / placeholders).
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
# WhatsApp number, digits only with country code, e.g. 919876543210
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_GSTIN=

# ===========================================================================
# CONTACT FORM DELIVERY — EMAIL (Nodemailer / SMTP)
# ===========================================================================
# Required to actually email contact-form leads to snasim@gmail.com. Until
# these are filled in, submissions are validated correctly but only logged
# server-side (delivered: false) — nothing is silently pretended to be sent.
#
# RECOMMENDED SETUP (free, simplest, no new account to create) — Gmail SMTP
# using an "App Password" on the recipient's own Gmail account:
#
#   1. Sign in to https://myaccount.google.com/security with snasim@gmail.com.
#   2. Turn on "2-Step Verification" if it isn't already on (required for
#      step 3 — this is a security setting, not a new account).
#   3. Go to https://myaccount.google.com/apppasswords, create an app
#      password (name it e.g. "AD Imperial Website"). Google shows a
#      16-character code — copy it.
#   4. Put that 16-character code in SMTP_PASSWORD below (NOT the normal
#      Gmail login password — Google won't accept the login password here
#      anyway once an app password exists).
#   5. Set SMTP_USER and SMTP_FROM to snasim@gmail.com too — this account
#      sends the mail to itself, so no second account is needed.
#
# This is free for this volume (Gmail's own sending cap is ~500/day, far
# above a small business contact form) and needs no third-party signup.
#
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=snasim@gmail.com
#   SMTP_PASSWORD=<16-character app password from step 3>
#   SMTP_FROM=snasim@gmail.com
#
# ALTERNATIVE — if you'd rather not enable an app password on
# snasim@gmail.com itself, use a free Brevo (formerly Sendinblue) account
# instead: sign up at https://www.brevo.com (free tier, 300 emails/day),
# then under Settings → SMTP & API → SMTP, use the credentials Brevo issues
# you as SMTP_HOST/SMTP_USER/SMTP_PASSWORD below. The recipient stays
# snasim@gmail.com either way — this only changes who/what sends the mail.
#
# Whichever you choose, the values below are ONLY the SENDER account's
# credentials. They do not need to match, and are never the client's normal
# Gmail login password.
SMTP_HOST=
SMTP_PORT=
# "true" for port 465 (implicit TLS). Leave blank to auto-detect from the
# port (465 = true, anything else = STARTTLS, e.g. 587).
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to SMTP_USER if left blank. Can be a display name,
# e.g. "AD Imperial Website" <sender@example.com>
SMTP_FROM=
# Optional override for the recipient address (defaults to snasim@gmail.com
# in code — src/lib/mailer.ts — only set this if the recipient ever changes).
CONTACT_RECIPIENT_EMAIL=

# --- Contact form delivery: webhook (optional, in addition to email) ------
# If set, contact-form submissions are ALSO POSTed here as JSON. Works with
# a Zapier / Make / n8n catch hook, a Slack/Discord incoming webhook, or
# your own endpoint. Independent of the email settings above.
CONTACT_WEBHOOK_URL=
